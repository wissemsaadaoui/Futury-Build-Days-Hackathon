# Copy to .env.local (never committed). All optional.

# API base URL used by the browser. Empty in production (same domain, see .env.production);
# unset in development = '/api' through the Vite proxy below.
# VITE_API_URL=http://localhost:8000

# Vite dev proxy target for /api (default http://localhost:8000), e.g. https://your-domain.example
# API_TARGET=
# base64 of "user:password" if the target API sits behind HTTP Basic auth
# API_AUTH=
