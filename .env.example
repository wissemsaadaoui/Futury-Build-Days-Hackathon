# Copier en .env (jamais commité) : cp .env.example .env

# Données (chemins relatifs à la racine du repo)
DATA_DIR=data/raw
EVENTS_CSV=data/events.csv

# Sorties de scripts/ (trades extraits)
PROCESSED_DIR=data/processed

# LLM : "openai" | "anthropic" | vide = résumés par template uniquement
LLM_PROVIDER=anthropic
LLM_API_KEY=
# Vide = modèle par défaut du provider (anthropic : claude-haiku-5-5, voir app/assistant/llm.py)
LLM_MODEL=
LLM_TIMEOUT_S=20

# Fronts autorisés par CORS (liste séparée par des virgules, jamais *). En production : le domaine public + les fronts locaux,
# ex. https://your-domain.example,http://localhost:5173,http://localhost:5174
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:5174

# Login applicatif (Bearer token) – ne jamais committer de vraies valeurs
# APP_PASSWORD : mot de passe unique de l'équipe IR (vide = aucun login possible)
APP_PASSWORD=
# SESSION_SECRET : clé de signature des tokens, ex. python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=
