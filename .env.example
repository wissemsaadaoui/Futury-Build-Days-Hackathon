# Copy to .env (never committed): cp .env.example .env
# No real value belongs in this file.

# Data (paths relative to the repo root)
DATA_DIR=data/raw
EVENTS_CSV=data/events.csv
# Output of scripts/extract_trades.py (on-book trades per ISIN)
PROCESSED_DIR=data/processed
# Without Xetra files in DATA_DIR: "auto" (default) serves synthetic market data, "off" disables it, "on" forces it
SYNTHETIC_DATA=auto

# Decision log and custom thresholds (SQLite, created automatically). Empty = data/decisions.db
DECISIONS_DB=

# LLM: "anthropic" | "openai" | empty = template summaries only
LLM_PROVIDER=anthropic
LLM_API_KEY=
# Empty = provider default (see app/assistant/llm.py)
LLM_MODEL=
LLM_TIMEOUT_S=20

# Front-ends allowed by CORS (comma-separated, never *), e.g. https://your-domain.example,http://localhost:5173
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:5174

# App login (Bearer token)
# APP_PASSWORD: shared password of the IR team (empty = nobody can log in)
APP_PASSWORD=
# SESSION_SECRET: token signing key, e.g. python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=
