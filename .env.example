# Copier en .env (jamais commité) : cp .env.example .env

# Données (chemins relatifs à la racine du repo)
DATA_DIR=data/raw
EVENTS_CSV=data/events.csv

# Sorties de scripts/ (trades extraits)
PROCESSED_DIR=data/processed

# LLM : "openai" | "anthropic" | vide = résumés par template uniquement
LLM_PROVIDER=anthropic
LLM_API_KEY=
# Vide = modèle par défaut du provider (anthropic : claude-haiku-5-5, voir app/assistant/llm.py)
LLM_MODEL=
LLM_TIMEOUT_S=20

# Front-end autorisé par CORS
FRONTEND_ORIGIN=http://localhost:5173

# Login applicatif (remplace le basic auth Caddy) – ne jamais committer de vraies valeurs
# APP_PASSWORD : mot de passe unique de l'équipe IR (vide = aucun login possible)
APP_PASSWORD=
# SESSION_SECRET : clé de signature des cookies, ex. python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=
# COOKIE_SECURE : true en prod (https), false en local (http://localhost)
COOKIE_SECURE=false
